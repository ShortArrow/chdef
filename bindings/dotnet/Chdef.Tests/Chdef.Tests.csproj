<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Chdef/Chdef.csproj" />
  </ItemGroup>

  <!-- The native library the binding loads. `CHDEF_NATIVE` points at the
       cdylib cargo built; CI sets it, and a developer can too. Without it
       the tests look in the workspace's default target directory. -->
  <PropertyGroup>
    <ChdefNative Condition="'$(CHDEF_NATIVE)' != ''">$(CHDEF_NATIVE)</ChdefNative>
    <ChdefNative Condition="'$(ChdefNative)' == ''">$(MSBuildThisFileDirectory)../../../target/release/$(NativePrefix)chdef_capi$(NativeSuffix)</ChdefNative>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(ChdefNative)')">
    <None Include="$(ChdefNative)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
