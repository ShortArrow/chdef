<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Chdef</RootNamespace>
    <AssemblyName>Chdef</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- The nuget.org distribution channel for the binding. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Chdef</PackageId>
    <Title>Chdef</Title>
    <Description>Channel and bit-field definitions for binary frames: read the CSVs, compute the frame layout, encode and decode frames, read the named bits of a channel, and edit a definition file as cells. A binding over the chdef Rust crate, carrying its native library for every supported runtime.</Description>
    <PackageProjectUrl>https://github.com/ShortArrow/chdef</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ShortArrow/chdef</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>csv;telemetry;bitfield;channel;codec;ffi</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../../README.md" Pack="true" PackagePath="\" />
    <None Include="../../../LICENSE-MIT" Pack="true" PackagePath="\" />
    <None Include="../../../LICENSE-APACHE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    The native library for each runtime, placed where the .NET runtime
    looks for it. `dotnet pack` in release.yml runs after the cargo builds
    have filled `runtimes/`; a source build has nothing here and finds the
    library through CHDEF_NATIVE instead.
  -->
  <ItemGroup>
    <None Include="runtimes/**/*" Pack="true" PackagePath="runtimes/" />
  </ItemGroup>
</Project>
