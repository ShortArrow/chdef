<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>

    <PackageId>Chdef</PackageId>
    <Description>Channel / bit-field definitions (CH設定 / BF設定): CSV parsing, frame layout, raw↔physical conversion. A binding over the chdef Rust crate.</Description>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/ShortArrow/chdef</RepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- The native library for each platform the Rust test matrix builds,
       placed where the .NET runtime looks for it. CI fills `runtimes/`
       before packing; a source build finds the library on the load path. -->
  <ItemGroup>
    <None Include="runtimes/**/*" Pack="true" PackagePath="runtimes/" />
  </ItemGroup>

</Project>
